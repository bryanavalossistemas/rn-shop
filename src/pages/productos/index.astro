---
import MainLayout from "@/layouts/MainLayout.astro";
import { CategorySchema } from "@/schemas/categories";
import { ProductSchema } from "@/schemas/products";
import Products from "@/components/Products";

const pageTitle = "R&N | Home";
const categories = CategorySchema.array().parse(await fetch(`${import.meta.env.PUBLIC_API_URL}/categories`).then((res) => res.json()));
const products = ProductSchema.array().parse(await fetch(`${import.meta.env.PUBLIC_API_URL}/products`).then((res) => res.json()));
---

<MainLayout content={{ title: pageTitle }}>
  <div class="flex flex-col min-h-screen">
    <Products client:load products={products} categories={categories} />
  </div>
</MainLayout>
